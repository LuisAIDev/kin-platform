# ============================================================
# KIN Platform — Environment variables reference
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# ¡NUNCA subas .env a GitHub!

# JWT — Firma de tokens de autenticación.
# Requerido por: kin-backend (application.yml), docker-compose.yml
# Valor para local: el que uses en tu entorno de desarrollo
JWT_SECRET=your_jwt_secret_here

# PostgreSQL — Contraseña de la base de datos (solo Docker).
# Requerido por: docker-compose.yml (raíz), kin-database/docker-compose.yml
POSTGRES_PASSWORD=your_postgres_password_here

# ============================================================
# DESARROLLO LOCAL — PostgreSQL (perfil 'dev', en vez de H2)
# ============================================================
# El backend de desarrollo usa PostgreSQL (servicio `postgres-db` de
# docker-compose.yml). Los valores por defecto apuntan a localhost:5432 con
# kin_admin. DATABASE_PASSWORD debe coincidir con POSTGRES_PASSWORD.
# OPCIONAL: solo define los que quieras sobrescribir (el resto usa defaults).
# DATABASE_URL=jdbc:postgresql://localhost:5432/kin_platform
# DATABASE_USER=kin_admin
# DATABASE_PASSWORD=your_db_password_here

# DeepSeek API — Clave para el chat con IA (proveedor único).
# Requerido por: kin-backend (DeepSeekConfig/AiEngineService), docker-compose.yml
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# Stripe — Procesamiento de pagos
# Requerido por: kin-backend (StripeService)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ============================================================
# EMAIL — Verificación obligatoria de correo (SMTP)
# ============================================================
# app.mail.enabled=false usa LoggingEmailSender (dev/test; el enlace se
# imprime en consola). En producción (perfil prod/render/enterprise) el
# default es true: si no configuras SMTP, la app falla explícitamente.
APP_MAIL_ENABLED=false
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_user
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=KIN Platform

# URL base del frontend usada para construir el enlace de verificación.
FRONTEND_BASE_URL=http://localhost:3000

# ============================================================
# PRODUCCIÓN (Render) — Base de datos PostgreSQL
# ============================================================
# DATABASE_URL=postgresql://user:pass@host:5432/kin_platform
# DATABASE_USER=kin_admin
# DATABASE_PASSWORD=your_db_password_here
# PORT=8080

# ============================================================
# PRODUCCIÓN (Render/Enterprise) — CORS y caché Redis (Fase 13)
# ============================================================
# ALLOWED_ORIGINS=http://localhost:3000,https://kin-platform.com
# KIN_REDIS_ENABLED=false
# SPRING_PROFILES_ACTIVE=prod   # o render / enterprise
