# ============================================================
# KIN Platform — Environment variables reference
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# ¡NUNCA subas .env a GitHub!

# JWT — Firma de tokens de autenticación.
# Requerido por: kin-backend (application.yml), docker-compose.yml
# Valor para local: el que uses en tu entorno de desarrollo
JWT_SECRET=your_jwt_secret_here

# PostgreSQL — Contraseña de la base de datos (solo Docker).
# Requerido por: docker-compose.yml (raíz), kin-database/docker-compose.yml
POSTGRES_PASSWORD=your_postgres_password_here

# ============================================================
# DESARROLLO LOCAL — PostgreSQL (perfil 'dev', en vez de H2)
# ============================================================
# El backend de desarrollo usa PostgreSQL (servicio `postgres-db` de
# docker-compose.yml). Los valores por defecto apuntan a localhost:5432 con
# kin_admin. DATABASE_PASSWORD debe coincidir con POSTGRES_PASSWORD.
# OPCIONAL: solo define los que quieras sobrescribir (el resto usa defaults).
# DATABASE_URL=jdbc:postgresql://localhost:5432/kin_platform
# DATABASE_USER=kin_admin
# DATABASE_PASSWORD=your_db_password_here

# DeepSeek API — Clave para el chat con IA (proveedor único).
# Requerido por: kin-backend (DeepSeekConfig/AiEngineService), docker-compose.yml
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# DeepSeek — Costo por millón de tokens (Fase 1, control de consumo de IA).
# IMPORTANTE: son los precios REALES de deepseek-v4-flash; PENDIENTES DE
# CONFIRMAR con el proveedor. Si quedan en 0, el gate de costo se desactiva
# con log explícito (no se inventa el precio). Configúralos antes de habilitar
# KIN_AI_COST_CONTROL_ENABLED=true en producción.
# DEEPSEEK_INPUT_COST_PER_1M=0
# DEEPSEEK_OUTPUT_COST_PER_1M=0

# ============================================================
# CONTROL DE CONSUMO DE IA (Fase 1)
# ============================================================
# Gate de costo ANTES de llamar a DeepSeek (reserva atómica por período).
KIN_AI_COST_CONTROL_ENABLED=true
# Límite máximo estimado (USD) por solicitud.
KIN_AI_MAX_REQUEST_ESTIMATE_USD=1.00
# Presupuestos de IA por plan y período (seed inicial; el valor operativo
# vive en PricingPlan.ai_budget_usd).
KIN_FREE_AI_BUDGET_USD=0.50
KIN_STANDARD_AI_BUDGET_USD=6.25
KIN_PREMIUM_AI_BUDGET_USD=8.75

# Stripe — Procesamiento de pagos
# Requerido por: kin-backend (StripeService)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ============================================================
# EMAIL — Verificación obligatoria de correo (SMTP)
# ============================================================
# app.mail.enabled=false usa LoggingEmailSender (dev/test; el enlace se
# imprime en consola). En producción (perfil prod/render/enterprise) el
# default es true: si no configuras SMTP, la app falla explícitamente.
APP_MAIL_ENABLED=false
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_user
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=KIN Platform

# URL base del frontend usada para construir el enlace de verificación.
FRONTEND_BASE_URL=http://localhost:3000

# ============================================================
# PRODUCCIÓN (Render) — Base de datos PostgreSQL
# ============================================================
# DATABASE_URL=postgresql://user:pass@host:5432/kin_platform
# DATABASE_USER=kin_admin
# DATABASE_PASSWORD=your_db_password_here
# PORT=8080

# ============================================================
# PRODUCCIÓN (Render/Enterprise) — CORS y caché Redis (Fase 13)
# ============================================================
# ALLOWED_ORIGINS=http://localhost:3000,https://kin-platform.com
# KIN_REDIS_ENABLED=false
# SPRING_PROFILES_ACTIVE=prod   # o render / enterprise

# ============================================================
# CONOCIMIENTO EXTERNO (ADR-021/ADR-023) - adaptador HTTP seguro
# ============================================================
# Defaults offline-first: KIN funciona sin Internet.
# Allowlist global por niveles (ADR-023):
#   Nivel 1 (global): api.worldbank.org, data-api.ecb.europa.eu
#   Nivel 2 (nacional): www.datos.gov.co (Colombia), servicios.ine.es (España)
# Para habilitar fuentes externas reales en UN ENTORNO DE PRUEBAS:
#   KNOWLEDGE_EXTERNAL_ENABLED=true
#   KNOWLEDGE_ALLOWED_DOMAINS=api.worldbank.org,data-api.ecb.europa.eu,www.datos.gov.co,servicios.ine.es
#   (las URLs concretas y su metadata viven en el perfil application-staging.yml)
# Modo sombra (ADR-025): ejecuta el motor con métricas/caché pero SIN propagar el
# resultado al enriquecimiento (invisible para el usuario). Para el periodo de
# observación en producción (Fase 1): KNOWLEDGE_SHADOW_ENABLED=true (sin external).
# En dev/test puedes usar una fuente controlada determinista:
#   KNOWLEDGE_TEST_SOURCE_ENABLED=true
KNOWLEDGE_EXTERNAL_ENABLED=false
KNOWLEDGE_ALLOWED_DOMAINS=
KNOWLEDGE_HTTP_BASE_URL=
KNOWLEDGE_HTTP_SOURCE_ID=external-http
KNOWLEDGE_HTTP_SOURCE_NAME=External Knowledge
KNOWLEDGE_HTTP_CONTENT_TYPES=application/json
KNOWLEDGE_TEST_SOURCE_ENABLED=false
KNOWLEDGE_SHADOW_ENABLED=false

# ============================================================
# OPEN TELEMETRY (ADR-022) - tracing distribuido opcional
# ============================================================
# Deshabilitado por defecto. Para habilitar tracing OTLP:
#   MANAGEMENT_TRACING_ENABLED=true
#   MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0   # default 0.0 (sin trazas)
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://colector-otlp:4318/v1/traces
# IMPORTANTE: el endpoint DEBE incluir la ruta /v1/traces (semantica OTLP HTTP
# de Micrometer). Sin ruta el exportador publica en "/" y el collector responde 404.
# Sin endpoint no hay exportacion; KIN no exige un collector.
MANAGEMENT_TRACING_ENABLED=false
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
