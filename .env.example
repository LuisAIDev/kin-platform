# Producto a activar: medical (IPS) | platform (empresas) | all (ambos)
KIN_PRODUCT=medical
KIN_LICENSING_ENABLED=true

# Contraseña de PostgreSQL local (cambiar)
DB_PASSWORD=cambiar_esta_password

# Secreto JWT en Base64 (mínimo 64 caracteres)
# Generar con: openssl rand -base64 64
JWT_SECRET=cambiar_este_secreto_base64